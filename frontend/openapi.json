{
  "components": {
    "schemas": {
      "ComparePlayersRequest": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/DeterministicContext"
          },
          "left_player_id": {
            "exclusiveMinimum": 0.0,
            "title": "Left Player Id",
            "type": "integer"
          },
          "right_player_id": {
            "exclusiveMinimum": 0.0,
            "title": "Right Player Id",
            "type": "integer"
          }
        },
        "required": [
          "left_player_id",
          "right_player_id",
          "context"
        ],
        "title": "ComparePlayersRequest",
        "type": "object"
      },
      "ComparePlayersResponse": {
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          },
          "result": {
            "$ref": "#/components/schemas/ComparePlayersResult"
          }
        },
        "required": [
          "meta",
          "result"
        ],
        "title": "ComparePlayersResponse",
        "type": "object"
      },
      "ComparePlayersResult": {
        "properties": {
          "left_player_id": {
            "exclusiveMinimum": 0.0,
            "title": "Left Player Id",
            "type": "integer"
          },
          "metrics": {
            "additionalProperties": {
              "$ref": "#/components/schemas/MetricComparison"
            },
            "title": "Metrics",
            "type": "object"
          },
          "right_player_id": {
            "exclusiveMinimum": 0.0,
            "title": "Right Player Id",
            "type": "integer"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "left_player_id",
          "right_player_id",
          "metrics",
          "summary"
        ],
        "title": "ComparePlayersResult",
        "type": "object"
      },
      "DeterministicContext": {
        "description": "Deterministic execution contract for all stochastic endpoints.",
        "properties": {
          "data_snapshot_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Data Snapshot Id",
            "type": "string"
          },
          "model_version": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Model Version",
            "type": "string"
          },
          "seed": {
            "maximum": 4294967295.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          }
        },
        "required": [
          "seed",
          "model_version",
          "data_snapshot_id"
        ],
        "title": "DeterministicContext",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MetricComparison": {
        "properties": {
          "better_player_id": {
            "exclusiveMinimum": 0.0,
