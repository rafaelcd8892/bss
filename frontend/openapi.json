            "exclusiveMinimum": 0.0,
            "title": "Right Player Id",
            "type": "integer"
          }
        },
        "required": [
          "left_player_id",
          "right_player_id",
          "context"
        ],
        "title": "ComparePlayersRequest",
        "type": "object"
