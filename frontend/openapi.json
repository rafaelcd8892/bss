          "left_player_id",
          "right_player_id",
          "metrics",
          "summary"
        ],
        "title": "ComparePlayersResult",
        "type": "object"
      },
      "DeterministicContext": {
        "description": "Deterministic execution contract for all stochastic endpoints.",
        "properties": {
          "data_snapshot_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Data Snapshot Id",
            "type": "string"
          },
          "model_version": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Model Version",
            "type": "string"
          },
          "seed": {
            "maximum": 4294967295.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          }
        },
        "required": [
          "seed",
          "model_version",
          "data_snapshot_id"
        ],
        "title": "DeterministicContext",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
