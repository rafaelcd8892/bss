            "enum": [
              "top",
              "bottom"
            ],
            "title": "Half",
            "type": "string"
          },
          "home_score_after_play": {
            "minimum": 0.0,
            "title": "Home Score After Play",
            "type": "integer"
          },
          "home_win_probability": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Home Win Probability",
            "type": "number"
          },
          "inning": {
            "minimum": 1.0,
            "title": "Inning",
            "type": "integer"
          },
          "outs_after": {
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Outs After",
            "type": "integer"
          },
          "outs_before": {
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Outs Before",
            "type": "integer"
          },
          "play_index": {
            "minimum": 1.0,
            "title": "Play Index",
            "type": "integer"
          },
          "runs_scored_on_play": {
            "minimum": 0.0,
            "title": "Runs Scored On Play",
            "type": "integer"
          }
