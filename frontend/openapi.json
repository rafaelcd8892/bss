            "minimum": 0.0,
            "title": "Home Score After Play",
            "type": "integer"
          },
          "inning": {
            "minimum": 1.0,
            "title": "Inning",
            "type": "integer"
          },
          "outs_after": {
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Outs After",
            "type": "integer"
